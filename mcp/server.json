{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.peculiar-systems/invoicein",
  "title": "InvoiceIn",
  "description": "XRechnung, Factur-X, Peppol, FatturaPA, KSeF → EN 16931 JSON + fix hints. Hosted; MIT=examples only",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/peculiar-systems/invoicein-examples/main/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "status": "active",
  "repository": {
    "url": "https://github.com/peculiar-systems/invoicein-examples",
    "source": "github"
  },
  "version": "0.1.2",
  "websiteUrl": "https://invoicein.peculiar.systems",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://invoicein-api.peculiar.systems/mcp",
      "headers": [
        {
          "name": "X-Api-Key",
          "description": "InvoiceIn API key. Optional: without it the demo quota of 20 invoices a day per IP applies.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
